[Unit]
Description=Isaac Lab GitHub App review bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=%h/.config/isaaclab-review-bot/environment
ExecStart=/usr/bin/env bash ${ISAACLAB_REVIEW_BOT_DIR}/launch_review_bot.sh --watch
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
